{
  "name": "salesforce-org-compare",
  "private": true,
  "version": "2.5.0",
  "description": "Chrome extension to compare Salesforce org metadata",
  "type": "module",
  "scripts": {
    "pretest": "node scripts/ensureTelemetryConfig.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "posthog:survey": "node scripts/createPosthogCsatSurvey.mjs",
    "posthog:survey:update": "node scripts/createPosthogCsatSurvey.mjs",
    "posthog:replay-flag": "node scripts/createPosthogSessionReplayFlag.mjs",
    "posthog:replay-flag:update": "node scripts/createPosthogSessionReplayFlag.mjs --update",
    "posthog:user-dashboard": "node scripts/createPosthogUserDashboard.mjs",
    "posthog:user-dashboard:update": "node scripts/createPosthogUserDashboard.mjs --update",
    "posthog:support-domain": "node scripts/createPosthogSupportExtensionDomain.mjs",
    "posthog:support-flag": "node scripts/createPosthogSupportFlag.mjs",
    "posthog:support-flag:update": "node scripts/createPosthogSupportFlag.mjs --update",
    "posthog:feature-controls-flag": "node scripts/createPosthogFeatureControlsFlag.mjs",
    "posthog:feature-controls-flag:update": "node scripts/createPosthogFeatureControlsFlag.mjs --update",
    "posthog:feature-controls-flag:smoke": "node scripts/createPosthogFeatureControlsFlag.mjs --update --smoke-test",
    "posthog:feature-controls-flag:reset": "node scripts/createPosthogFeatureControlsFlag.mjs --update --reset",
    "posthog:feature-controls-flag:production": "node scripts/createPosthogFeatureControlsFlag.mjs --update --production",
    "posthog:popup-controls-flag": "node scripts/createPosthogPopupControlsFlag.mjs",
    "posthog:popup-controls-flag:update": "node scripts/createPosthogPopupControlsFlag.mjs --update",
    "posthog:popup-controls-flag:reset": "node scripts/createPosthogPopupControlsFlag.mjs --update --reset",
    "posthog:error-tracking": "node scripts/createPosthogErrorTrackingSetup.mjs",
    "posthog:error-tracking:update": "node scripts/createPosthogErrorTrackingSetup.mjs --update",
    "pack:chrome": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-chrome-store.ps1"
  },
  "devDependencies": {
    "posthog-js": "^1.379.0",
    "vitest": "^3.1.4"
  }
}
